<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="Programacion2">
    

        <class>com.programacion2.dominio.Persona</class>
        <class>com.programacion2.dominio.Materia</class>
        <class>com.programacion2.dominio.Profesor</class>
         <class>com.programacion2.dominio.Alumno</class>


        <exclude-unlisted-classes/>

        <properties>

            <property
                name="javax.jdo.option.ConnectionDriverName"
                value="com.mysql.cj.jdbc.Driver"/>

            <property
                name="javax.jdo.option.ConnectionURL"
                value="jdbc:mysql://localhost:3306/programacion2"/>

            <property
                name="javax.jdo.option.ConnectionUserName"
                value="programacion2"/>

              <property
                name="javax.jdo.option.ConnectionPassword"
                value="Programacion2"/>


            <property
                name="datanucleus.schema.autoCreateAll"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>
